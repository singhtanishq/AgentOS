# ============================================================
# AgentOS — example environment configuration (placeholders only)
# Copy to .env and adjust for your local environment.
# NEVER commit a real .env file.
# ============================================================

# --- Global -------------------------------------------------
# development | test | production
AGENTOS_ENV=development

# --- Control plane (Go) -------------------------------------
AGENTOS_HTTP_ADDR=:8080
AGENTOS_LOG_LEVEL=info
# PostgreSQL connection string (local compose credentials)
AGENTOS_DATABASE_URL=postgres://agentos:CHANGE_ME@localhost:5432/agentos?sslmode=disable
AGENTOS_REDIS_ADDR=localhost:6379
AGENTOS_NATS_URL=nats://localhost:4222
AGENTOS_OPA_URL=http://localhost:8181
# Internal endpoint of the Python runtime (execution plane)
AGENTOS_RUNTIME_INTERNAL_URL=http://localhost:8090
AGENTOS_SESSION_COOKIE=agentos_session
AGENTOS_SESSION_TTL=12h
# Base64-encoded 32-byte AES-256 key used for credential encryption.
# Generate with: openssl rand -base64 32
AGENTOS_SECRETS_MASTER_KEY=

# --- Agent runtime (Python) ---------------------------------
AGENTOS_CONTROL_PLANE_URL=http://localhost:8080
AGENTOS_OTLP_ENDPOINT=

# --- Web dashboard (Next.js) --------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Docker Compose infrastructure (local-only credentials) -
POSTGRES_USER=agentos
POSTGRES_PASSWORD=agentos_dev
POSTGRES_DB=agentos
NATS_ARGS=
# S3-compatible object storage (SeaweedFS in S3 gateway mode)
S3_ROOT_USER=agentos-minio
S3_ROOT_PASSWORD=agentos_minio_dev
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=agentos_grafana_dev
